{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-software-testing/branch-set@0.1",
  "title": "Branch-set document",
  "description": "Keys are sorted and unique. Checked by the validator and not expressible here: sort order, branch_covered equal to the number of keys, and the count not exceeding branch_total. Additional keys (for example t_s or cases in a snapshot) are allowed.",
  "type": "object",
  "required": ["schema", "program", "branch_key_format", "branch_total", "branch_covered", "covered_branch_keys"],
  "properties": {
    "schema": { "const": "agent-software-testing/branch-set@0.1" },
    "program": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "branch_key_format": { "const": "file:line:block_id:branch_id" },
    "branch_total": { "type": "integer", "minimum": 0 },
    "branch_covered": { "type": "integer", "minimum": 0 },
    "t_s": { "type": "integer", "minimum": 0 },
    "covered_branch_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^.+:(0|[1-9][0-9]*):(0|[1-9][0-9]*):(0|[1-9][0-9]*)$" }
    }
  }
}
